# Copy to .env and fill in. Never commit .env or a real key.
# NOTE: the app does not load .env by itself; load it first: set -a; source .env; set +a; uvicorn app:app
GEMINI_API_KEY=
LLM_BACKEND=gemini
GEMINI_MODEL=gemma-4-26b-a4b-it
LOCAL_BASE_URL=http://localhost:11434/v1
# Leave LOCAL_MODEL unset unless you need another model (code default: gemma4:e4b).
# An empty "LOCAL_MODEL=" would override the default with an empty name.
# LOCAL_MODEL=gemma4:e4b
